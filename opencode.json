{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "docker",
                "exec",
                "-i",
                "frankenphp",
                "php",
                "/var/www/html/mycms_with_deepseek/artisan",
                "boost:mcp"
            ]
        }
    },
    "permission": {
        "skill": {
            "*": "allow",
            "frontend-design": "allow",
            "ui-ux-pro-max": "allow"
        }
    }
}
